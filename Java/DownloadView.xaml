<UserControl x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Jerry_Craft_Launcher.NET_Framework_4._5_WPF"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 子侧边栏 -->
        <Border Grid.Column="0" Background="#FAFAFA"
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,16,8,0">
                <RadioButton GroupName="DownloadSubNav"
                             Content="{DynamicResource Download.Minecraft}"
                             Style="{StaticResource SubNavButtonStyle}"
                             IsChecked="True" Tag="Minecraft"
                             Checked="SubNav_Checked"
                             Margin="0,0,0,2"/>
                <RadioButton GroupName="DownloadSubNav"
                             Content="{DynamicResource Download.Mod}"
                             Style="{StaticResource SubNavButtonStyle}"
                             Tag="Mod"
                             Checked="SubNav_Checked"
                             Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1">

            <!-- Minecraft 页 -->
            <Grid x:Name="MinecraftPanel" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题 + 刷新 -->
                <Grid Grid.Row="0" Margin="24,20,24,0">
                    <TextBlock Text="{DynamicResource Download.MinecraftTitle}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="LoadingText"
                                   Text="{DynamicResource Download.Loading}"
                                   FontSize="12" Foreground="#999999"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <Button Content="{DynamicResource Download.Refresh}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="30"
                                Click="RefreshManifest_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 分类切换 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            Margin="24,16,24,0">
                    <RadioButton GroupName="MinecraftCategory"
                                 Content="{DynamicResource Download.Cat.Release}"
                                 Style="{StaticResource TopNavButtonStyle}"
                                 Tag="Release"
                                 IsChecked="True"
                                 Checked="Category_Checked"/>
                    <RadioButton GroupName="MinecraftCategory"
                                 Content="{DynamicResource Download.Cat.Snapshot}"
                                 Style="{StaticResource TopNavButtonStyle}"
                                 Tag="Snapshot"
                                 Checked="Category_Checked"/>
                    <RadioButton GroupName="MinecraftCategory"
                                 Content="{DynamicResource Download.Cat.Old}"
                                 Style="{StaticResource TopNavButtonStyle}"
                                 Tag="Old"
                                 Checked="Category_Checked"/>
                    <RadioButton GroupName="MinecraftCategory"
                                 Content="{DynamicResource Download.Cat.AprilFools}"
                                 Style="{StaticResource TopNavButtonStyle}"
                                 Tag="AprilFools"
                                 Checked="Category_Checked"/>
                </StackPanel>

                <!-- 版本列表 -->
                <ListBox Grid.Row="2"
                         x:Name="ManifestVersionList"
                         Margin="24,16,24,24"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ManifestVersionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#EEF0FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Id}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#333333"/>
                                    <TextBlock Text="{Binding ReleaseTime}"
                                               FontSize="10"
                                               Foreground="#999999"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayType}"
                                           FontSize="11"
                                           Foreground="#888888"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid x:Name="ModPanel" Background="White" Visibility="Collapsed">
                <local:ModSearchView />
            </Grid>

            <!-- 其他占位页 -->
            <Grid x:Name="PlaceholderPanel" Background="White" Visibility="Collapsed">
                <TextBlock x:Name="PlaceholderText" Text=""
                           FontSize="24" Foreground="#DDDDDD"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
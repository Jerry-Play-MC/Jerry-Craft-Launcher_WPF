<UserControl x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.ModSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Style="{StaticResource InputTextBoxStyle}"
                     KeyDown="SearchBox_KeyDown"/>

            <ComboBox x:Name="TypeBox"
                      Grid.Column="1"
                      Style="{StaticResource ModernComboBoxStyle}"
                      Width="130"
                      Margin="8,0,0,0"
                      SelectionChanged="TypeBox_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource Download.Mod}"/>
                <ComboBoxItem Content="{DynamicResource Download.Modpack}"/>
                <ComboBoxItem Content="{DynamicResource Download.Datapack}"/>
                <ComboBoxItem Content="{DynamicResource ModSearch.ResourcePack}"/>
                <ComboBoxItem Content="{DynamicResource Download.Shader}"/>
            </ComboBox>

            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Content="{DynamicResource ModSearch.Search}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="38"
                    Margin="8,0,0,0"
                    Click="Search_Click"/>
        </Grid>

        <ListBox x:Name="ModList"
                 Grid.Row="1"
                 Margin="24,16,24,0"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ModList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd"
                                        Background="#F7F7F7"
                                        CornerRadius="8"
                                        Padding="12">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#EEF0FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="48" Height="48"
                                CornerRadius="8"
                                Background="#F0F0F0">
                            <Image Source="{Binding Icon}"
                                   Width="48" Height="48"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#333333"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}"
                                       FontSize="11" Foreground="#999999"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding DownloadsText}"
                                   FontSize="11" Foreground="#888888"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PrevButton"
                    Grid.Column="0"
                    Content="{DynamicResource ModSearch.PrevPage}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="30"
                    Click="Prev_Click"/>

            <TextBlock x:Name="PageInfoText"
                       Grid.Column="1"
                       FontSize="12" Foreground="#666666"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button x:Name="NextButton"
                    Grid.Column="2"
                    Content="{DynamicResource ModSearch.NextPage}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="30"
                    Click="Next_Click"/>
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.Java.Forms.View.TaskProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Jerry_Craft_Launcher.NET_Framework_4._5_WPF">
    <UserControl.Resources>

        <Style x:Key="SlimProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#E6E6E6"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource SlimProgressBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TaskState.Success}">
                    <Setter Property="Foreground" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TaskState.Failed}">
                    <Setter Property="Foreground" Value="#E53935"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TaskState.Running}">
                    <Setter Property="Foreground" Value="#2196F3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TaskState.Pending}">
                    <Setter Property="Foreground" Value="#BDBDBD"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource SlimProgressBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TaskState.Success}">
                    <Setter Property="Foreground" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TaskState.Failed}">
                    <Setter Property="Foreground" Value="#E53935"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TaskState.Skipped}">
                    <Setter Property="Foreground" Value="#BDBDBD"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6" Padding="10,8"
                            Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="6">
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  BorderThickness="0" Background="Transparent"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding CurrentAction}"
                                                   FontSize="10" Foreground="#999"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding SummaryText}"
                                               Foreground="#888" FontSize="12"
                                               Margin="12,0,12,0"
                                               VerticalAlignment="Center"/>

                                    <ProgressBar Grid.Column="2"
                                                 Style="{StaticResource GroupProgressBar}"
                                                 Height="6" Maximum="1"
                                                 Value="{Binding OverallProgress}"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>

                            <StackPanel>
                                <!-- 子任务列表 -->
                                <ItemsControl ItemsSource="{Binding Children}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12" Foreground="#333"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                           FontSize="11" Foreground="#888"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="2"
                                                             Style="{StaticResource SubProgressBar}"
                                                             Height="4" Maximum="1"
                                                             Value="{Binding Progress}"
                                                             VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 日志折叠区 -->
                                <Expander FontSize="11" Margin="0,8,0,0" Foreground="#888">
                                    <Expander.Header>
                                        <TextBlock Text="Log" FontSize="11" Foreground="#888"/>
                                    </Expander.Header>
                                    <Border Background="#F8F8F8" CornerRadius="4" Margin="0,4,0,0">
                                        <ScrollViewer MaxHeight="160"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding LogLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontFamily="Consolas" FontSize="10"
                                                                   Foreground="#555"
                                                                   TextWrapping="NoWrap"
                                                                   Margin="6,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
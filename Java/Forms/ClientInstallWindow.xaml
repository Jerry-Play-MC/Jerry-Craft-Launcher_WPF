<UserControl x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.ClientInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 标题栏 -->
            <RowDefinition Height="*"/>
            <!-- 主体 -->
            <RowDefinition Height="Auto"/>
            <!-- 按钮栏 -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Height="60" Margin="24,0,24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Content="←"
                            Width="36" Height="36"
                            FontSize="16"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Back_Click"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ClientInstall.Title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#333333"/>
                        <TextBlock x:Name="GameVersionDisplay"
                                   FontSize="11" Foreground="#999999"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <!-- 表单区 -->
                <RowDefinition Height="2*"/>
                <!-- 日志区 -->
            </Grid.RowDefinitions>

            <!-- 表单区：去掉 MaxHeight，加 MinHeight 兜底 -->
            <ScrollViewer Grid.Row="0"
                          MinHeight="120"
                          VerticalScrollBarVisibility="Auto"
                          Margin="24,16,24,0">
                <StackPanel>
                    <!-- 游戏版本（只读） -->
                    <TextBlock Text="{DynamicResource ClientInstall.GameVersion}"
                               FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox x:Name="GameVersionBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             IsReadOnly="True"/>

                    <!-- 加载器 -->
                    <TextBlock Text="{DynamicResource ClientInstall.Loader}"
                               FontSize="12" Foreground="#666666"
                               Margin="0,14,0,4"/>
                    <ComboBox x:Name="LoaderBox"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectionChanged="LoaderBox_SelectionChanged"/>

                    <!-- 加载器版本 -->
                    <TextBlock Text="{DynamicResource ClientInstall.LoaderVersion}"
                               FontSize="12" Foreground="#666666"
                               Margin="0,14,0,4"/>
                    <ComboBox x:Name="LoaderVersionBox"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectionChanged="LoaderVersionBox_SelectionChanged"/>
                    <TextBlock x:Name="LoaderVersionHint"
                               Text="{DynamicResource ClientInstall.LoaderVersionHint}"
                               FontSize="11" Foreground="#999999"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                    <!-- LiteLoader -->
                    <CheckBox x:Name="LiteLoaderCheck"
                              Content="LiteLoader"
                              FontSize="13"
                              Margin="0,18,0,0"
                              Checked="LiteLoaderCheck_Changed"
                              Unchecked="LiteLoaderCheck_Changed"/>
                    <TextBlock x:Name="LiteLoaderHint"
                               Text="仅支持 Minecraft 1.12.2 及以下，可与 Forge 共存"
                               FontSize="11" Foreground="#999999"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                    <!-- OptiFine -->
                    <CheckBox x:Name="OptifineCheck"
                              Content="{DynamicResource ClientInstall.Optifine}"
                              FontSize="13"
                              Margin="0,18,0,0"
                              Checked="OptifineCheck_Changed"
                              Unchecked="OptifineCheck_Changed"/>

                    <TextBlock Text="{DynamicResource ClientInstall.OptifineVersion}"
                               FontSize="12" Foreground="#666666"
                               Margin="0,10,0,4"/>
                    <ComboBox x:Name="OptifineVersionBox"
                              Style="{StaticResource ModernComboBoxStyle}"
                              IsEnabled="False"
                              SelectionChanged="OptifineVersionBox_SelectionChanged"/>
                    <TextBlock x:Name="OptifineHint"
                               Text="{DynamicResource ClientInstall.OptifineHint}"
                               FontSize="11" Foreground="#999999"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                    <Border Background="#FFF8E1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,18,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="11" Foreground="#8D6E00"
                                   Text="{DynamicResource ClientInstall.Warning}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 日志区 -->
            <Border Grid.Row="1"
                    Margin="24,14,24,16"
                    Background="#FAFAFA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinHeight="120">
                <Grid>
                    <TextBox x:Name="LogBox"
                             Background="Transparent"
                             Foreground="#333333"
                             BorderThickness="0"
                             FontFamily="{DynamicResource App.MonoFontFamily}"
                             FontSize="11"
                             Padding="10,8"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="LogPlaceholder"
                               Text="{DynamicResource ClientInstall.LogPlaceholder}"
                               Foreground="#BBBBBB"
                               FontFamily="{DynamicResource App.MonoFontFamily}"
                               FontSize="11"
                               Margin="12,10,0,0"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 按钮栏 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid Height="60" Margin="0,0,24,0">
                <TextBlock x:Name="InstallStatusText"
                           FontSize="11" Foreground="#4F46E5"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="CancelButton"
                            Content="{DynamicResource ClientInstall.Cancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="InstallButton"
                            Content="{DynamicResource ClientInstall.Install}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Install_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
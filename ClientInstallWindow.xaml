<Window x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.ClientInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装客户端"
        Width="640" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F5F5F5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="安装客户端"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <Button Content="✕" Width="40" Height="40"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              MaxHeight="400"
                              VerticalScrollBarVisibility="Auto"
                              Margin="24,16,24,0">
                    <StackPanel>

                        <!-- 游戏版本（只读） -->
                        <TextBlock Text="游戏版本"
                                   FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="GameVersionBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 IsReadOnly="True"/>

                        <!-- 加载器 -->
                        <TextBlock Text="加载器"
                                   FontSize="12" Foreground="#666666"
                                   Margin="0,14,0,4"/>
                        <ComboBox x:Name="LoaderBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectionChanged="LoaderBox_SelectionChanged"/>

                        <!-- 加载器版本 -->
                        <TextBlock Text="加载器版本"
                                   FontSize="12" Foreground="#666666"
                                   Margin="0,14,0,4"/>
                        <ComboBox x:Name="LoaderVersionBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectionChanged="LoaderVersionBox_SelectionChanged"/>
                        <TextBlock x:Name="LoaderVersionHint"
                                   Text="留空使用最新版"
                                   FontSize="11" Foreground="#999999"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- OptiFine -->
                        <CheckBox x:Name="OptifineCheck"
                                  Content="安装 OptiFine"
                                  FontSize="13"
                                  Margin="0,18,0,0"
                                  Checked="OptifineCheck_Changed"
                                  Unchecked="OptifineCheck_Changed"/>

                        <TextBlock Text="OptiFine 版本"
                                   FontSize="12" Foreground="#666666"
                                   Margin="0,10,0,4"/>
                        <ComboBox x:Name="OptifineVersionBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  IsEnabled="False"
                                  SelectionChanged="OptifineVersionBox_SelectionChanged"/>
                        <TextBlock x:Name="OptifineHint"
                                   Text="勾选上方复选框后启用。选择 OptiFine 版本会自动填入兼容的 Forge 版本。"
                                   FontSize="11" Foreground="#999999"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>

                        <Border Background="#FFF8E1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,18,0,0">
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="11" Foreground="#8D6E00"
                                       Text="安装过程会从网络下载大量文件，进度会在下方日志中输出。安装完成后版本会自动出现在启动页的版本列表里。"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 日志区 -->
                <Border Grid.Row="1"
                        Margin="24,14,24,16"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        MinHeight="150">
                    <Grid>
                        <TextBox x:Name="LogBox"
                                 Background="Transparent"
                                 Foreground="#333333"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Courier New, monospace"
                                 FontSize="11"
                                 Padding="10,8"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="LogPlaceholder"
                                   Text="安装日志将显示在这里..."
                                   Foreground="#BBBBBB"
                                   FontFamily="Consolas, Courier New, monospace"
                                   FontSize="11"
                                   Margin="12,10,0,0"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 按钮栏 -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="0,0,16,0">
                    <TextBlock x:Name="InstallStatusText"
                               FontSize="11" Foreground="#4F46E5"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="取消"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Cancel_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="InstallButton"
                                Content="安装"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Install_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
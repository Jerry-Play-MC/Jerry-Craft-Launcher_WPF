<Window x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.SelectLoginTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择登录方式"
        Width="440" Height="290"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F5F5F5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="选择登录方式" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Content="✕" Width="40" Height="40"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,18,24,20">
                <TextBlock Text="请选择你要创建的角色类型："
                           FontSize="12" Foreground="#666666"
                           Margin="0,0,0,12"/>

                <!-- 正版登录 -->
                <Button x:Name="MicrosoftButton"
                        Height="56" Margin="0,0,0,10" Cursor="Hand"
                        Click="Microsoft_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="White"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="8" Padding="16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="6"
                                            Background="#0078D4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="M" FontSize="16" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="正版登录" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>
                                        <TextBlock Text="使用 Microsoft 账号登录"
                                                   FontSize="11" Foreground="#999999"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#EEF0FF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4F46E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 离线登录 -->
                <Button x:Name="OfflineButton"
                        Height="56" Cursor="Hand"
                        Click="Offline_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="White"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="8" Padding="16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="6"
                                            Background="#10B981"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="O" FontSize="16" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="离线登录" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>
                                        <TextBlock Text="创建本地离线角色"
                                                   FontSize="11" Foreground="#999999"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#EEF0FF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4F46E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
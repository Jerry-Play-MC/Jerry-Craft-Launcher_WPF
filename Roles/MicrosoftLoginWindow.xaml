<Window x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正版登录"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F5F5F5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Microsoft 正版登录"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Content="✕" Width="40" Height="40"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,20,28,24">

                <Border Width="48" Height="48"
                        CornerRadius="8"
                        Background="#0078D4"
                        HorizontalAlignment="Center">
                    <TextBlock Text="M" FontSize="24" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="使用 Microsoft 账号登录"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4"/>

                <TextBlock Text="点击下方按钮后会在浏览器中打开微软登录页"
                           FontSize="12" Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- 用户码显示区 -->
                <Border x:Name="UserCodePanel"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="浏览器中提示的代码"
                                   FontSize="11" Foreground="#999999"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="UserCodeText"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#4F46E5"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="（已复制到剪贴板）"
                                   FontSize="10" Foreground="#BBBBBB"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Text="点击下方按钮开始登录"
                           FontSize="12" Foreground="#666666"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MinHeight="32"
                           Margin="0,0,0,14"/>

                <ProgressBar x:Name="Progress"
                             Height="4"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Margin="0,0,0,16"/>

                <Button x:Name="LoginButton"
                        Content="开始登录"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        MinWidth="160"
                        Click="Login_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
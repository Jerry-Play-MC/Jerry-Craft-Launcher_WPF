<Window x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Jerry_Craft_Launcher.NET_Framework_4._5_WPF"
        mc:Ignorable="d"
        Title="Jerry Craft Launcher"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid x:Name="RootGrid" Background="#F5F5F5" Opacity="0"
          SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Jerry Craft Launcher"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="32,0,0,0">
                    <RadioButton GroupName="TopNav" Content="启动"
                                 Style="{StaticResource TopNavButtonStyle}"
                                 IsChecked="True" Tag="Launch"
                                 Checked="TopNav_Checked"/>
                    <RadioButton GroupName="TopNav" Content="下载"
                                 Style="{StaticResource TopNavButtonStyle}"
                                 Tag="Download"
                                 Checked="TopNav_Checked"/>
                    <RadioButton GroupName="TopNav" Content="服务器"
                                 Style="{StaticResource TopNavButtonStyle}"
                                 Tag="Server"
                                 Checked="TopNav_Checked"/>
                    <RadioButton GroupName="TopNav" Content="设置"
                                 Style="{StaticResource TopNavButtonStyle}"
                                 Tag="Settings"
                                 Checked="TopNav_Checked"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="—" Width="46" Height="48"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Minimize_Click"/>
                    <Button Content="✕" Width="46" Height="48"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <ContentControl Grid.Row="1"
                        x:Name="MainContent"
                        Margin="0"/>
    </Grid>
</Window>
<Window x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.ServerInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装服务端"
        Width="640" Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F5F5F5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="安装服务端"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <Button Content="✕" Width="40" Height="40"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- 主体：上表单 + 下日志 -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 表单区 -->
                <ScrollViewer Grid.Row="0"
                              MaxHeight="330"
                              VerticalScrollBarVisibility="Auto"
                              Margin="24,16,24,0">
                    <StackPanel>

                        <TextBlock Text="服务器名"
                                   FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerNameBox"
                                 Style="{StaticResource InputTextBoxStyle}"/>
                        <TextBlock Text="会成为 Server 目录下的文件夹名，建议用英文、数字、下划线"
                                   FontSize="11" Foreground="#999999"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="游戏版本"
                                   FontSize="12" Foreground="#666666"
                                   Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      x:Name="GameVersionBox"
                                      Height="38"
                                      IsEditable="True"
                                      FontSize="13"
                                      VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="刷新"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Click="RefreshVersions_Click"/>
                        </Grid>
                        <TextBlock x:Name="VersionStatusText"
                                   Text=""
                                   FontSize="11" Foreground="#999999"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="加载器"
                                   FontSize="12" Foreground="#666666"
                                   Margin="0,14,0,4"/>
                        <ComboBox x:Name="LoaderBox"
                                  Height="38"
                                  FontSize="13"
                                  VerticalContentAlignment="Center"/>

                        <TextBlock Text="加载器版本"
                                   FontSize="12" Foreground="#666666"
                                   Margin="0,14,0,4"/>
                        <TextBox x:Name="LoaderVersionBox"
                                 Style="{StaticResource InputTextBoxStyle}"/>
                        <TextBlock Text="留空使用最新版。例如 Forge 填 47.2.0、NeoForge 填 21.1.0、Fabric/Quilt 填 Loader 版本号"
                                   FontSize="11" Foreground="#999999"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- 日志区 -->
                <Border Grid.Row="1"
                        Margin="24,14,24,16"
                        Background="#E0E0E0"
                        CornerRadius="6"
                        MinHeight="150">
                    <Grid>
                        <TextBox x:Name="LogBox"
                                 Background="Transparent"
                                 Foreground="#D4D4D4"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Courier New, monospace"
                                 FontSize="11"
                                 Padding="10,8"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="LogPlaceholder"
                                   Text="安装日志将显示在这里..."
                                   Foreground="#666666"
                                   FontFamily="Consolas, Courier New, monospace"
                                   FontSize="11"
                                   Margin="12,10,0,0"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 按钮栏 -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="0,0,16,0">
                    <TextBlock x:Name="InstallStatusText"
                               FontSize="11" Foreground="#4F46E5"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="取消"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Cancel_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="InstallButton"
                                Content="安装"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Install_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
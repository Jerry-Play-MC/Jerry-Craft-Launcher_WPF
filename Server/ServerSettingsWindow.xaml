<Window x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ServerSettings.Title}"
        Width="620" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F5F5F5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{DynamicResource ServerSettings.Title}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <Button Content="✕" Width="40" Height="40"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,16">

                    <TextBlock Text="{DynamicResource ServerSettings.Basic}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#888888" Margin="0,0,0,8"/>

                    <TextBlock Text="{DynamicResource ServerSettings.ServerName}"
                               FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="{DynamicResource ServerSettings.Motd}"
                               FontSize="12" Foreground="#666666"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="MotdBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="{DynamicResource ServerSettings.Port}"
                               FontSize="12" Foreground="#666666"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="PortBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="{DynamicResource ServerSettings.Players}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#888888" Margin="0,20,0,8"/>

                    <CheckBox x:Name="OnlineModeCheck"
                              Content="{DynamicResource ServerSettings.OnlineMode}"
                              Margin="0,4,0,0" FontSize="13"/>
                    <CheckBox x:Name="WhitelistCheck"
                              Content="{DynamicResource ServerSettings.Whitelist}"
                              Margin="0,8,0,0" FontSize="13"/>
                    <CheckBox x:Name="EnforceWhitelistCheck"
                              Content="{DynamicResource ServerSettings.EnforceWhitelist}"
                              Margin="0,8,0,0" FontSize="13"/>
                    <CheckBox x:Name="PvpCheck"
                              Content="{DynamicResource ServerSettings.Pvp}"
                              Margin="0,8,0,0" FontSize="13"/>
                    <CheckBox x:Name="AllowFlightCheck"
                              Content="{DynamicResource ServerSettings.AllowFlight}"
                              Margin="0,8,0,0" FontSize="13"/>
                    <CheckBox x:Name="CheatCheck"
                              Content="{DynamicResource ServerSettings.Cheat}"
                              Margin="0,8,0,0" FontSize="13"/>

                    <TextBlock Text="{DynamicResource ServerSettings.MaxPlayers}"
                               FontSize="12" Foreground="#666666"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="MaxPlayersBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="{DynamicResource ServerSettings.World}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#888888" Margin="0,20,0,8"/>

                    <TextBlock Text="{DynamicResource ServerSettings.Gamemode}"
                               FontSize="12" Foreground="#666666" Margin="0,0,0,4"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="GamemodeBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="{DynamicResource ServerSettings.Difficulty}"
                               FontSize="12" Foreground="#666666" Margin="0,12,0,4"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="DifficultyBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="{DynamicResource ServerSettings.ViewDistance}"
                               FontSize="12" Foreground="#666666" Margin="0,12,0,4"/>
                    <TextBox x:Name="ViewDistanceBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="{DynamicResource ServerSettings.SimDistance}"
                               FontSize="12" Foreground="#666666" Margin="0,12,0,4"/>
                    <TextBox x:Name="SimDistanceBox" Style="{StaticResource InputTextBoxStyle}"/>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button Content="{DynamicResource ServerSettings.Cancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource ServerSettings.Save}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
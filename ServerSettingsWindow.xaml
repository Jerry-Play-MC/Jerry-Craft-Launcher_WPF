<Window x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器设置"
        Width="620" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F5F5F5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="服务器设置"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <Button Content="✕" Width="40" Height="40"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,16">

                    <TextBlock Text="基本" FontSize="12" FontWeight="SemiBold"
                               Foreground="#888888" Margin="0,0,0,8"/>

                    <TextBlock Text="服务器名（会重命名文件夹）"
                               FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="简介 (MOTD)" FontSize="12" Foreground="#666666"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="MotdBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="端口" FontSize="12" Foreground="#666666"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="PortBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="玩家" FontSize="12" FontWeight="SemiBold"
                               Foreground="#888888" Margin="0,20,0,8"/>

                    <CheckBox x:Name="OnlineModeCheck"
                              Content="正版登录 (online-mode)"
                              Margin="0,4,0,0" FontSize="13"/>
                    <CheckBox x:Name="WhitelistCheck"
                              Content="启用白名单 (white-list)"
                              Margin="0,8,0,0" FontSize="13"/>
                    <CheckBox x:Name="EnforceWhitelistCheck"
                              Content="强制白名单 (enforce-whitelist)"
                              Margin="0,8,0,0" FontSize="13"/>
                    <CheckBox x:Name="PvpCheck"
                              Content="允许 PVP (pvp)"
                              Margin="0,8,0,0" FontSize="13"/>
                    <CheckBox x:Name="AllowFlightCheck"
                              Content="允许飞行 (allow-flight)"
                              Margin="0,8,0,0" FontSize="13"/>
                    <CheckBox x:Name="CheatCheck"
                              Content="允许作弊 (enable-command-block)"
                              Margin="0,8,0,0" FontSize="13"/>

                    <TextBlock Text="最大玩家数" FontSize="12" Foreground="#666666"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="MaxPlayersBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="世界" FontSize="12" FontWeight="SemiBold"
                               Foreground="#888888" Margin="0,20,0,8"/>

                    <TextBlock Text="游戏模式 (survival / creative / adventure / spectator)"
                               FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox x:Name="GamemodeBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="难度 (peaceful / easy / normal / hard)"
                               FontSize="12" Foreground="#666666" Margin="0,12,0,4"/>
                    <TextBox x:Name="DifficultyBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="视距 (view-distance)"
                               FontSize="12" Foreground="#666666" Margin="0,12,0,4"/>
                    <TextBox x:Name="ViewDistanceBox" Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="模拟距离 (simulation-distance)"
                               FontSize="12" Foreground="#666666" Margin="0,12,0,4"/>
                    <TextBox x:Name="SimDistanceBox" Style="{StaticResource InputTextBoxStyle}"/>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button Content="取消"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="保存"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
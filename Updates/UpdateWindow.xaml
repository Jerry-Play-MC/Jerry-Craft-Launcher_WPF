<Window x:Class="Jerry_Craft_Launcher.NET_Framework_4._5_WPF.Updater.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="480" Height="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F5F5F5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="发现新版本"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <Button Content="✕" Width="40" Height="40"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,20">

                <TextBlock x:Name="VersionText"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#333333"/>

                <TextBlock Text="更新内容"
                           FontSize="12" Foreground="#888888"
                           Margin="0,14,0,6"/>
                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        MinHeight="80"
                        MaxHeight="140">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesText"
                                   FontSize="12" Foreground="#555555"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="StatusText"
                           FontSize="12" Foreground="#4F46E5"
                           Margin="0,14,0,6"/>

                <ProgressBar x:Name="Progress"
                             Height="6"
                             Minimum="0" Maximum="100"
                             Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button x:Name="CancelButton"
                            Content="稍后"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="UpdateButton"
                            Content="立即更新"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Update_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>